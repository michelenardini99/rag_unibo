[Unit]
Description=Lancia rag-indexing.service ogni notte

[Timer]
# 03:00 per non contendere la GPU con eventuali utenti attivi durante il giorno.
OnCalendar=*-*-* 03:00:00
# Se la macchina era spenta all'orario previsto, recupera il run appena si riaccende.
Persistent=true
# Sfasa l'avvio fino a 10 minuti per evitare che più timer scattino nello stesso istante.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
