# Copiare in .env e adattare prima di eseguire `docker compose up -d`.
# .env è già escluso da git (vedi .gitignore).

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=ateneo_docs

# --- vLLM (GPU A — modello generativo, vision-capable) ---
VLLM_PORT=8000
VLLM_DEVICE_ID=1
VLLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90

# --- Client locale (venv host, non containerizzato) ---
# BGE-M3 + BGE-Reranker-v2-m3 + Granite-Docling girano in locale su GPU B tramite FlagEmbedding/Docling (requirements.txt).
QDRANT_URL=http://localhost:${QDRANT_HTTP_PORT}
VLLM_BASE_URL=http://localhost:${VLLM_PORT}/v1
EMBEDDINGS_DEVICE_ID=2
EMBEDDING_MODEL_ID=BAAI/bge-m3
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3

# Cache locale dei pesi Hugging Face per i modelli eseguiti nel venv host
# (Docling, BGE-M3, BGE-Reranker). Evita di riscaricare i pesi ad ogni ambiente virtuale nuovo.
HF_HOME=.cache/huggingface

# --- Hugging Face ---
# Necessario solo per pesi gated (es. Gemma). Lasciare vuoto se si usa solo Qwen2.5-VL.
HUGGING_FACE_HUB_TOKEN=
